# Receiptor local environment template
# Copy this to .env.local for local dev, or add each value in Vercel / deployment settings.

# --- Server / indexer ---
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-this-to-a-strong-password
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3000
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/receiptor

# Merchant wallet used by the indexer to record receipts server-side.
MERCHANT_SECRET_KEY=SRXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
RECEIPT_LEDGER_CONTRACT_ID=replace-with-your-deployed-contract-id

# --- Web app (NEXT_PUBLIC values are safe to expose in the browser) ---
NEXT_PUBLIC_INDEXER_API_URL=http://localhost:3001
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_RECEIPT_LEDGER_CONTRACT_ID=replace-with-your-deployed-contract-id
